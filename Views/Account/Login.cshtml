@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - AttendanceApp</title>
    @* satu-satunya stylesheet yang dipakai; seluruh tampilan memakai kelas Bootstrap, tanpa CSS manual *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
</head>
<body class="bg-body-secondary">
    @* halaman login mandiri (tanpa _Layout) supaya navbar dan footer aplikasi tidak ikut tampil *@
    <main class="container min-vh-100 d-flex align-items-center justify-content-center">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-sm-8 col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 text-center">
                        <h1 class="h3 fw-bold mb-1">AttendanceApp</h1>
                        <p class="text-muted mb-4">Sign in to continue</p>

                        @if (TempData["Error"] != null)
                        {
                            <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
                        }

                        @* satu-satunya cara login: challenge ke Google OAuth *@
                        <a class="btn btn-light border w-100 d-flex align-items-center justify-content-center gap-2 py-2"
                           asp-controller="Account" asp-action="GoogleLogin">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 48 48"
                                 aria-hidden="true" focusable="false">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                            </svg>
                            <span class="fw-semibold">Sign in with Google</span>
                        </a>
                    </div>
                </div>

                <p class="text-center text-muted small mt-3 mb-0">&copy; @DateTime.Now.Year AttendanceApp</p>
            </div>
        </div>
    </main>
</body>
</html>
